## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vsconfig
*.VC.db
*.VC.VC.opendb

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# ASP.NET local settings
appsettings.Development.json
appsettings.*.local.json

# Database and local data
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3

# Secrets and certificates
secrets.json
*.pfx
*.p12
*.key
*.pem

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
coverage.*

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

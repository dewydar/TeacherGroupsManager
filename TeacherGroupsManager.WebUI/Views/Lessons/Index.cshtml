@{
    ViewData["Title"] = L["Lessons"];
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
}
@Html.AntiForgeryToken()
<div class="em-page-header">
    <h1>@ViewData["Title"]</h1>
    <div class="em-add-btn-wrap">
        <a class="btn btn-primary" asp-action="Create">@L["Add"]</a>
    </div>
</div>
<div class="em-toolbar panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">@L["LessonTitle"]</label><input id="Title" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["AcademicYear"]</label><select id="AcademicYearId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Group"]</label><select id="GroupId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["LessonType"]</label><select id="LessonType" class="form-select"><option value="">@L["All"]</option><option value="1">@L["PrivateLesson"]</option><option value="2">@L["GroupLesson"]</option></select></div>
        <div class="col-md-2"><label class="form-label">@L["DateFrom"]</label><input id="LessonDateFrom" class="form-control" type="date" /></div>
        <div class="col-md-2"><label class="form-label">@L["DateTo"]</label><input id="LessonDateTo" class="form-control" type="date" /></div>
        <div class="col-md-2"><label class="form-label">@L["Month"]</label><input id="Month" class="form-control" type="number" min="1" max="12" /></div>
        <div class="col-md-2"><label class="form-label">@L["Year"]</label><input id="Year" class="form-control" type="number" /></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive app-table-shell">
    <table id="lessonsTable" class="table align-middle w-100">
        <thead><tr><th>@L["Title"]</th><th>@L["Group"]</th><th>@L["LessonType"]</th><th>@L["LessonDate"]</th><th>@L["Price"]</th><th>@L["Month"]</th><th>@L["Year"]</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#lessonsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { title: '#Title', academicYearId: '#AcademicYearId', groupId: '#GroupId', lessonType: '#LessonType', lessonDateFrom: '#LessonDateFrom', lessonDateTo: '#LessonDateTo', month: '#Month', year: '#Year' },
            columns: [
                { data: 'title' },
                { data: 'groupName' },
                { data: 'lessonType', render: renderLessonType },
                { data: 'lessonDate', render: renderDate },
                { data: 'price', render: renderMoney },
                { data: 'month' },
                { data: 'year' },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return `<a class="btn btn-sm btn-outline-secondary" href="/Lessons/Attendance/${id}">@L["Attendance"]</a> ${renderActions('Lessons', id)}`; } }
            ]
        });
    </script>
}





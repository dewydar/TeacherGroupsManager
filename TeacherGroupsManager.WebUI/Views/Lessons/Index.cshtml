@using TeacherGroupsManager.Shared.Extensions
@model IReadOnlyList<TeacherGroupsManager.Dtos.LessonDto>
@{ ViewData["Title"] = "الدروس"; }
<p><a class="btn btn-primary" asp-action="Create">إضافة درس</a></p>
<div class="panel"><table class="table"><thead><tr><th>العنوان</th><th>المجموعة</th><th>النوع</th><th>التاريخ</th><th>السعر</th><th>الشهر</th><th>السنة</th></tr></thead><tbody>
@foreach (var item in Model){<tr><td>@item.Title</td><td>@item.GroupName</td><td>@item.LessonType.ToArabic()</td><td>@item.LessonDate.ToString("yyyy/MM/dd")</td><td>@item.Price.ToString("N2")</td><td>@item.Month</td><td>@item.Year</td></tr>}
</tbody></table></div>

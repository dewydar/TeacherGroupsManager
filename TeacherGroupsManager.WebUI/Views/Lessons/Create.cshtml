@using TeacherGroupsManager.Core.Enums
@model TeacherGroupsManager.Dtos.CreateLessonDto
@{ ViewData["Title"] = "إضافة درس"; }
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">عنوان الدرس</label><input class="form-control" name="Title" value="@Model.Title" /></div>
        <div class="col-md-6"><label class="form-label">المجموعة</label><select class="form-select" name="GroupId"><option value="0">اختر المجموعة</option>@foreach (var group in (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups){<option value="@group.Id">@group.Name</option>}</select></div>
        <div class="col-md-4"><label class="form-label">نوع الدرس</label><select class="form-select" name="LessonType"><option value="@((int)LessonType.Group)">درس للمجموعة بالكامل</option><option value="@((int)LessonType.Private)">درس خاص</option></select></div>
        <div class="col-md-4"><label class="form-label">تاريخ الدرس</label><input class="form-control" type="datetime-local" name="LessonDate" value="@Model.LessonDate.ToString("yyyy-MM-ddTHH:mm")" /></div>
        <div class="col-md-4"><label class="form-label">السعر</label><input class="form-control" type="number" step="0.01" name="Price" value="@Model.Price" /></div>
        <div class="col-md-6"><label class="form-label">الشهر</label><input class="form-control" type="number" name="Month" value="@Model.Month" /></div>
        <div class="col-md-6"><label class="form-label">السنة</label><input class="form-control" type="number" name="Year" value="@Model.Year" /></div>
        <div class="col-12"><label class="form-label">الوصف</label><textarea class="form-control" name="Description">@Model.Description</textarea></div>
    </div>
    <button class="btn btn-primary mt-3">حفظ</button>
</form>

@{
    ViewData["Title"] = L["Students"];
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
}
@Html.AntiForgeryToken()
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">@L["StudentName"]</label><input id="FullName" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">@L["AcademicYear"]</label><select id="AcademicYearId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@L["Group"]</label><select id="GroupId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-3 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive"><table id="reportStudentsTable" class="table w-100"><thead><tr><th>@L["Student"]</th><th>@L["AcademicYear"]</th><th>@L["Group"]</th><th>@L["Mobile"]</th></tr></thead><tbody></tbody></table></div>
@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#reportStudentsTable',
            url: '@Url.Action("StudentsData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { fullName: '#FullName', academicYearId: '#AcademicYearId', groupId: '#GroupId' },
            columns: [{ data: 'fullName' }, { data: 'academicYearName' }, { data: 'groupName' }, { data: 'mobile' }]
        });
    </script>
}





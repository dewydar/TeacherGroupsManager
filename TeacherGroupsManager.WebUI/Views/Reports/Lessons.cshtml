@{
    ViewData["Title"] = L["Lessons"];
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
}
@Html.AntiForgeryToken()
<div class="em-page-header">
    <h1>@ViewData["Title"]</h1>
</div>
<div class="em-toolbar panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">@L["LessonTitle"]</label><input id="Title" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["AcademicYear"]</label><select id="AcademicYearId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Group"]</label><select id="GroupId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Month"]</label><input id="Month" class="form-control" type="number" min="1" max="12" /></div>
        <div class="col-md-2"><label class="form-label">@L["Year"]</label><input id="Year" class="form-control" type="number" /></div>
        <div class="col-md-2 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive app-table-shell"><table id="reportLessonsTable" class="table w-100"><thead><tr><th>@L["LessonTitle"]</th><th>@L["Group"]</th><th>@L["LessonType"]</th><th>@L["LessonDate"]</th><th>@L["Price"]</th></tr></thead><tbody></tbody></table></div>
@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#reportLessonsTable',
            url: '@Url.Action("LessonsData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { title: '#Title', academicYearId: '#AcademicYearId', groupId: '#GroupId', month: '#Month', year: '#Year' },
            columns: [
                { data: 'title' }, { data: 'groupName' }, { data: 'lessonType', render: renderLessonType },
                { data: 'lessonDate', render: renderDate }, { data: 'price', render: renderMoney }
            ]
        });
    </script>
}





@model TeacherGroupsManager.Dtos.DashboardSummaryDto
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = L["Dashboard"];
    var requiredAmount = Model.CurrentMonthTotalRequiredAmount.ToString(CultureInfo.InvariantCulture);
    var paidAmount = Model.CurrentMonthTotalPaidAmount.ToString(CultureInfo.InvariantCulture);
    var remainingAmount = Model.CurrentMonthTotalRemainingAmount.ToString(CultureInfo.InvariantCulture);
}
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.StudentsUrl"><div class="stat-title">@L["TotalStudents"]</div><div class="stat-value">@Model.TotalStudents</div></a></div>
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.GroupsUrl"><div class="stat-title">@L["TotalGroups"]</div><div class="stat-value">@Model.TotalGroups</div></a></div>
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.PrivateGroupsUrl"><div class="stat-title">@L["PrivateGroups"]</div><div class="stat-value">@Model.TotalPrivateGroups</div></a></div>
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.PublicGroupsUrl"><div class="stat-title">@L["PublicGroups"]</div><div class="stat-value">@Model.TotalPublicGroups</div></a></div>
    <div class="col-sm-6 col-xl-3"><div class="card-stat"><div class="stat-title">@L["TotalTeachers"]</div><div class="stat-value">@Model.TotalTeachers</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card-stat"><div class="stat-title">@L["TotalAssistants"]</div><div class="stat-value">@Model.TotalAssistantTeachers</div></div></div>
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.PaidStudentsUrl"><div class="stat-title">@L["PaidStudentsThisMonth"]</div><div class="stat-value">@Model.CurrentMonthPaidStudentsCount</div></a></div>
    <div class="col-sm-6 col-xl-3"><a class="card-stat" href="@Model.UnpaidStudentsUrl"><div class="stat-title">@L["UnpaidStudentsThisMonth"]</div><div class="stat-value">@Model.CurrentMonthUnpaidStudentsCount</div></a></div>
</div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="panel">
            <h2 class="h5">@L["MonthlyPaymentsSummary"]</h2>
            <canvas id="paymentsChart" height="160"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <h2 class="h5">@L["GroupsByDay"]</h2>
            <table class="table table-sm">
                <thead><tr><th>@L["Day"]</th><th>@L["TotalGroups"]</th><th>@L["Groups"]</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.GroupsByDay)
                    {
                        <tr><td>@item.DayName</td><td>@item.GroupsCount</td><td>@string.Join(", ", item.GroupNames)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-12">
        <div class="panel">
            <h2 class="h5">@L["EachGroupSummary"]</h2>
            <div class="row g-3">
                @foreach (var group in Model.PaymentsPerGroup)
                {
                    <div class="col-sm-6 col-xl-4">
                        <a class="card-stat" href="@group.GroupDetailsUrl">
                            <div class="fw-bold">@group.GroupName</div>
                            <div class="small text-muted">@L["StudentsLabel"]: @group.TotalStudents | @L["PaidStudentsLabel"]: @group.PaidStudentsCount | @L["UnpaidStudentsLabel"]: @group.UnpaidStudentsCount</div>
                            <div class="mt-2">@L["CollectedAmount"]: @group.TotalCollectedAmount.ToString("N2") | @L["RemainingAmount"]: @group.RemainingAmount.ToString("N2")</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        new Chart(document.getElementById('paymentsChart'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(JsonSerializer.Serialize(L["RequiredAmount"].Value)), @Html.Raw(JsonSerializer.Serialize(L["PaidAmount"].Value)), @Html.Raw(JsonSerializer.Serialize(L["RemainingAmount"].Value))],
                datasets: [{ label: @Html.Raw(JsonSerializer.Serialize(L["ChartAmount"].Value)), data: [@requiredAmount, @paidAmount, @remainingAmount], backgroundColor: ['#5a8dee', '#39b980', '#f05d5e'] }]
            }
        });
    </script>
}

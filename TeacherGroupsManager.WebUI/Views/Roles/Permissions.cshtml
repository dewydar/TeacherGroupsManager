@model TeacherGroupsManager.Dtos.RolePermissionsDto
@{
    ViewData["Title"] = L["Permissions"] + " - " + L["Role"];
    var selected = Model.PermissionIds.ToHashSet();
}
<form method="post" class="panel">
    <input type="hidden" name="roleId" value="@Model.RoleId" />
    <h2 class="h5 mb-3">@Model.RoleArabicName</h2>
    <div class="row g-2">
        @foreach (var permission in (IReadOnlyList<TeacherGroupsManager.Dtos.PermissionDto>)ViewBag.Permissions)
        {
            <div class="col-md-4">
                <label class="form-check border rounded p-2 w-100">
                    <input class="form-check-input ms-1" type="checkbox" name="permissionIds" value="@permission.Id" @(selected.Contains(permission.Id) ? "checked" : "") />
                    <span>@permission.ArabicName</span>
                    <span class="d-block text-muted small">@permission.Code</span>
                </label>
            </div>
        }
    </div>
    <button class="btn btn-primary mt-3">@L["Save"]</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index">@L["Back"]</a>
</form>





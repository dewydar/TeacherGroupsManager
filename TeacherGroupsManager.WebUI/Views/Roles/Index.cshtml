@model IReadOnlyList<TeacherGroupsManager.Dtos.RoleDto>
@{
    ViewData["Title"] = "إدارة الأدوار";
}
<p><a class="btn btn-primary" asp-action="Create">إضافة دور</a></p>
<div class="panel">
    <table class="table align-middle">
        <thead><tr><th>الاسم</th><th>الاسم العربي</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ArabicName</td>
                    <td>@(item.IsActive ? "نشط" : "غير نشط")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">تعديل</a>
                        @if (User.IsInRole(TeacherGroupsManager.Core.Constants.AppConstants.AdminRole))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Permissions" asp-route-id="@item.Id">الصلاحيات</a>
                        }
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('هل تريد حذف هذا السجل؟')">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <h2 class="h5 mt-4">الصلاحيات</h2>
    <div class="row">
        @foreach (var permission in (IReadOnlyList<TeacherGroupsManager.Dtos.PermissionDto>)ViewBag.Permissions)
        {
            <div class="col-md-4 mb-2">@permission.ArabicName <span class="text-muted">(@permission.Code)</span></div>
        }
    </div>
</div>

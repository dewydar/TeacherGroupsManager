@{
    ViewData["Title"] = L["RolesManagement"];
    var permissions = (IReadOnlyList<TeacherGroupsManager.Dtos.PermissionDto>)ViewBag.Permissions;
    var permissionsUrl = User.IsInRole(TeacherGroupsManager.Core.Constants.AppConstants.AdminRole) ? "'/Roles/Permissions'" : "null";
}
@Html.AntiForgeryToken()
<div class="em-page-header">
    <h1>@ViewData["Title"]</h1>
    <div class="em-add-btn-wrap">
        <a class="btn btn-primary" asp-action="Create">@L["Add"]</a>
    </div>
</div>
<div class="em-toolbar panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label">@L["Role"]</label><input id="Name" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">@L["ArabicName"]</label><input id="ArabicName" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Status"]</label><select id="IsActive" class="form-select"><option value="">@L["All"]</option><option value="true">@L["Active"]</option><option value="false">@L["Inactive"]</option></select></div>
        <div class="col-md-2 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel">
    <div class="table-responsive app-table-shell">
        <table id="rolesTable" class="table align-middle w-100">
            <thead><tr><th>@L["Name"]</th><th>@L["ArabicName"]</th><th>@L["Status"]</th><th></th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
    <h2 class="h5 mt-4">@L["Permissions"]</h2>
    <div class="row">
        @foreach (var permission in permissions)
        {
            <div class="col-md-4 mb-2">@permission.ArabicName <span class="text-muted">(@permission.Code)</span></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#rolesTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { name: '#Name', arabicName: '#ArabicName', isActive: '#IsActive' },
            columns: [
                { data: 'name' },
                { data: 'arabicName' },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Roles', id, false, @Html.Raw(permissionsUrl)); } }
            ]
        });
    </script>
}





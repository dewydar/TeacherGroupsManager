@model TeacherGroupsManager.Dtos.RoleDto
@{ ViewData["Title"] = L["Edit"] + " - " + L["RolesManagement"]; }
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3"><label class="form-label">@L["EnglishRoleName"]</label><input class="form-control" name="Name" value="@Model.Name" /></div>
    <div class="mb-3"><label class="form-label">@L["ArabicRoleName"]</label><input class="form-control" name="ArabicName" value="@Model.ArabicName" /></div>
    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><label class="form-check-label">@L["Active"]</label></div>
    <button class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-outline-secondary" asp-action="Index">@L["Back"]</a>
</form>





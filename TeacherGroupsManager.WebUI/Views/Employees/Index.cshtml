@{
    ViewData["Title"] = L["EmployeesManagement"];
    var roles = (IReadOnlyList<TeacherGroupsManager.Dtos.RoleDto>)ViewBag.Roles;
}
@Html.AntiForgeryToken()
<p><a class="btn btn-primary" asp-action="Create">@L["Add"]</a></p>
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">@L["Name"]</label><input id="FullName" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Username"]</label><input id="Username" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Mobile"]</label><input id="Mobile" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Email"]</label><input id="Email" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Role"]</label><select id="RoleId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in roles){<option value="@item.Id">@item.ArabicName</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Status"]</label><select id="IsActive" class="form-select"><option value="">@L["All"]</option><option value="true">@L["Active"]</option><option value="false">@L["Inactive"]</option></select></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive">
    <table id="employeesTable" class="table align-middle w-100">
        <thead><tr><th>@L["Name"]</th><th>@L["Mobile"]</th><th>@L["Email"]</th><th>@L["Username"]</th><th>@L["Role"]</th><th>@L["Status"]</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#employeesTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { fullName: '#FullName', username: '#Username', mobile: '#Mobile', email: '#Email', roleId: '#RoleId', isActive: '#IsActive' },
            columns: [
                { data: 'fullName' },
                { data: 'mobile' },
                { data: 'email' },
                { data: 'username' },
                { data: 'roleArabicName' },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Employees', id); } }
            ]
        });
    </script>
}





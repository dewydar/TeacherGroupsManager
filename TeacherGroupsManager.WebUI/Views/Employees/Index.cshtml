@{
    ViewData["Title"] = "إدارة الموظفين";
    var roles = (IReadOnlyList<TeacherGroupsManager.Dtos.RoleDto>)ViewBag.Roles;
}
@Html.AntiForgeryToken()
<p><a class="btn btn-primary" asp-action="Create">إضافة موظف</a></p>
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">الاسم</label><input id="FullName" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">اسم المستخدم</label><input id="Username" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">الجوال</label><input id="Mobile" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">البريد</label><input id="Email" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">الدور</label><select id="RoleId" class="form-select"><option value="">الكل</option>@foreach (var item in roles){<option value="@item.Id">@item.ArabicName</option>}</select></div>
        <div class="col-md-2"><label class="form-label">الحالة</label><select id="IsActive" class="form-select"><option value="">الكل</option><option value="true">نشط</option><option value="false">غير نشط</option></select></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">بحث</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">إعادة تعيين</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">تحديث</button></div>
    </div>
</div>
<div class="panel table-responsive">
    <table id="employeesTable" class="table align-middle w-100">
        <thead><tr><th>الاسم</th><th>الجوال</th><th>البريد</th><th>اسم المستخدم</th><th>الدور</th><th>الحالة</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#employeesTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { fullName: '#FullName', username: '#Username', mobile: '#Mobile', email: '#Email', roleId: '#RoleId', isActive: '#IsActive' },
            columns: [
                { data: 'fullName' },
                { data: 'mobile' },
                { data: 'email' },
                { data: 'username' },
                { data: 'roleArabicName' },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Employees', id); } }
            ]
        });
    </script>
}

@model IReadOnlyList<TeacherGroupsManager.Dtos.EmployeeDto>
@{ ViewData["Title"] = "إدارة الموظفين"; }
<p><a class="btn btn-primary" asp-action="Create">إضافة موظف</a></p>
<div class="panel">
<table class="table"><thead><tr><th>الاسم</th><th>الجوال</th><th>البريد</th><th>اسم المستخدم</th><th>الدور</th><th>الحالة</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.FullName</td><td>@item.Mobile</td><td>@item.Email</td><td>@item.Username</td><td>@item.RoleArabicName</td><td>@(item.IsActive ? "نشط" : "غير نشط")</td></tr>
}
</tbody></table>
</div>

@{
    ViewData["Title"] = "المجموعات";
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var employees = (IReadOnlyList<TeacherGroupsManager.Dtos.EmployeeDto>)ViewBag.Employees;
    var initialGroupType = ViewBag.GroupType is null ? "" : ((int)ViewBag.GroupType).ToString();
}
@Html.AntiForgeryToken()
<p><a class="btn btn-primary" asp-action="Create">إضافة مجموعة</a></p>
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">اسم المجموعة</label><input id="Name" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">السنة الدراسية</label><select id="AcademicYearId" class="form-select"><option value="">الكل</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">النوع</label><select id="GroupType" class="form-select"><option value="">الكل</option><option value="1">درس خاص</option><option value="2">مجموعة عامة</option></select></div>
        <div class="col-md-2"><label class="form-label">المدرس</label><select id="TeacherId" class="form-select"><option value="">الكل</option>@foreach (var item in employees){<option value="@item.Id">@item.FullName</option>}</select></div>
        <div class="col-md-2"><label class="form-label">المدرس المساعد</label><select id="AssistantTeacherId" class="form-select"><option value="">الكل</option>@foreach (var item in employees){<option value="@item.Id">@item.FullName</option>}</select></div>
        <div class="col-md-1"><label class="form-label">اليوم</label><select id="DayOfWeek" class="form-select"><option value="">الكل</option><option value="6">السبت</option><option value="0">الأحد</option><option value="1">الإثنين</option><option value="2">الثلاثاء</option><option value="3">الأربعاء</option><option value="4">الخميس</option><option value="5">الجمعة</option></select></div>
        <div class="col-md-1"><label class="form-label">الحالة</label><select id="IsActive" class="form-select"><option value="">الكل</option><option value="true">نشط</option><option value="false">غير نشط</option></select></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">بحث</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">إعادة تعيين</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">تحديث</button></div>
    </div>
</div>
<div class="panel table-responsive">
    <table id="groupsTable" class="table align-middle w-100">
        <thead><tr><th>الاسم</th><th>السنة الدراسية</th><th>النوع</th><th>اليوم</th><th>الوقت</th><th>سعر الدرس</th><th>الحالة</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $('#GroupType').val('@initialGroupType');
        initServerDataTable({
            tableSelector: '#groupsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { name: '#Name', academicYearId: '#AcademicYearId', groupType: '#GroupType', teacherId: '#TeacherId', assistantTeacherId: '#AssistantTeacherId', dayOfWeek: '#DayOfWeek', isActive: '#IsActive' },
            columns: [
                { data: 'name' },
                { data: 'academicYearName' },
                { data: 'groupType', render: renderGroupType },
                { data: 'dayOfWeek', render: renderDayOfWeek },
                { data: 'startTime', render: function (data, type, row) { return `${row.startTime} - ${row.endTime}`; } },
                { data: 'defaultLessonPrice', render: renderMoney },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Groups', id, true); } }
            ]
        });
    </script>
}

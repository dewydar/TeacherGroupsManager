@using TeacherGroupsManager.Core.Enums
@model TeacherGroupsManager.Dtos.CreateGroupDto
@{ ViewData["Title"] = "إضافة مجموعة"; }
<form method="post" class="panel">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">اسم المجموعة</label><input class="form-control" name="Name" value="@Model.Name" /></div>
        <div class="col-md-6"><label class="form-label">السنة الدراسية</label><select class="form-select" name="AcademicYearId"><option value="">اختر السنة الدراسية</option>@foreach (var year in (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears){<option value="@year.Id">@year.Name</option>}</select></div>
        <div class="col-md-4"><label class="form-label">نوع المجموعة</label><select class="form-select" name="GroupType"><option value="@((int)GroupType.Public)">مجموعة عامة</option><option value="@((int)GroupType.Private)">درس خاص</option></select></div>
        <div class="col-md-4"><label class="form-label">اليوم</label><select class="form-select" name="DayOfWeek"><option value="6">السبت</option><option value="0">الأحد</option><option value="1">الإثنين</option><option value="2">الثلاثاء</option><option value="3">الأربعاء</option><option value="4">الخميس</option><option value="5">الجمعة</option></select></div>
        <div class="col-md-4"><label class="form-label">سعر الدرس الافتراضي</label><input class="form-control" type="number" step="0.01" name="DefaultLessonPrice" value="@Model.DefaultLessonPrice" /></div>
        <div class="col-md-6"><label class="form-label">وقت البداية</label><input class="form-control" type="time" name="StartTime" value="@Model.StartTime.ToString("HH:mm")" /></div>
        <div class="col-md-6"><label class="form-label">وقت النهاية</label><input class="form-control" type="time" name="EndTime" value="@Model.EndTime.ToString("HH:mm")" /></div>
    </div>
    <button class="btn btn-primary mt-3">حفظ</button>
</form>

@using TeacherGroupsManager.Core.Enums
@model TeacherGroupsManager.Dtos.CreateGroupDto
@{
    ViewData["Title"] = L["Add"] + " - " + L["Groups"];
}
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@L["GroupName"]</label><input class="form-control" name="Name" value="@Model.Name" /></div>
        <div class="col-md-6">
            <label class="form-label">@L["AcademicYear"]</label><select class="form-select" name="AcademicYearId">
            <option value="0">@L["SelectAcademicYear"]</option>@foreach (var year in (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears){
            <option value="@year.Id">@year.Name</option>
        }
    </select>
</div>
<div class="col-md-4"><label class="form-label">@L["GroupType"]</label><select class="form-select" name="GroupType"><option value="@((int)GroupType.Public)">@L["PublicGroup"]</option><option value="@((int)GroupType.Private)">@L["PrivateLesson"]</option></select></div>
<div class="col-md-4"><label class="form-label">@L["Day"]</label><select class="form-select" name="DayOfWeek"><option value="6">@L["Saturday"]</option><option value="0">@L["Sunday"]</option><option value="1">@L["Monday"]</option><option value="2">@L["Tuesday"]</option><option value="3">@L["Wednesday"]</option><option value="4">@L["Thursday"]</option><option value="5">@L["Friday"]</option></select></div>
<div class="col-md-4"><label class="form-label">@L["DefaultLessonPrice"]</label><input class="form-control" type="number" step="0.01" name="DefaultLessonPrice" value="@Model.DefaultLessonPrice" /></div>
<div class="col-md-6"><label class="form-label">@L["StartTime"]</label><input class="form-control" type="time" name="StartTime" value="@Model.StartTime.ToString("HH:mm")" /></div>
<div class="col-md-6"><label class="form-label">@L["EndTime"]</label><input class="form-control" type="time" name="EndTime" value="@Model.EndTime.ToString("HH:mm")" /></div>
</div>
<button class="btn btn-primary mt-3">@L["Save"]</button>
</form>






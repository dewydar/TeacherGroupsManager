@using TeacherGroupsManager.Shared.Extensions
@model TeacherGroupsManager.Dtos.GroupDto?
@{ ViewData["Title"] = L["Details"] + " - " + L["Group"]; }
@if (Model is null)
{
    <div class="alert alert-info">@L["FailureDefault"]</div>
}
else
{
    <div class="panel">
        <h2 class="h5">@Model.Name</h2>
        <dl class="row">
            <dt class="col-sm-3">@L["AcademicYear"]</dt><dd class="col-sm-9">@Model.AcademicYearName</dd>
            <dt class="col-sm-3">@L["Group"]</dt><dd class="col-sm-9">@Model.GroupType.ToArabic()</dd>
            <dt class="col-sm-3">@L["Time"]</dt><dd class="col-sm-9">@Model.DayOfWeek.DayToArabic() @Model.StartTime - @Model.EndTime</dd>
            <dt class="col-sm-3">@L["Price"]</dt><dd class="col-sm-9">@Model.DefaultLessonPrice.ToString("N2")</dd>
            <dt class="col-sm-3">@L["CreatedBy"]</dt><dd class="col-sm-9">@(Model.CreatedByEmployeeName ?? "-")</dd>
            <dt class="col-sm-3">@L["CreatedAt"]</dt><dd class="col-sm-9">@(Model.CreatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</dd>
            <dt class="col-sm-3">@L["UpdatedBy"]</dt><dd class="col-sm-9">@(Model.UpdatedByEmployeeName ?? "-")</dd>
            <dt class="col-sm-3">@L["UpdatedAt"]</dt><dd class="col-sm-9">@(Model.UpdatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</dd>
        </dl>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">@L["Edit"]</a>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["Back"]</a>
    </div>
}





@using TeacherGroupsManager.Core.Enums
@using TeacherGroupsManager.Dtos
@model TeacherGroupsManager.Dtos.EditGroupDto
@{
    ViewData["Title"] = L["Edit"] + " - " + L["Groups"];
    var schedules = Model.Schedules is { Count: > 0 }
        ? Model.Schedules
        : new List<GroupScheduleDto> { new(Model.DayOfWeek, Model.StartTime, Model.EndTime) };
}
<form method="post" class="panel" id="groupForm">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="DayOfWeek" id="PrimaryDayOfWeek" value="@((int)schedules[0].DayOfWeek)" />
    <input type="hidden" name="StartTime" id="PrimaryStartTime" value="@schedules[0].StartTime.ToString("HH:mm")" />
    <input type="hidden" name="EndTime" id="PrimaryEndTime" value="@schedules[0].EndTime.ToString("HH:mm")" />
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@L["GroupName"]</label><input class="form-control" name="Name" value="@Model.Name" /></div>
        <div class="col-md-6"><label class="form-label">@L["AcademicYear"]</label><select class="form-select" name="AcademicYearId"><option value="0">@L["SelectAcademicYear"]</option>@foreach (var year in (IReadOnlyList<AcademicYearDto>)ViewBag.AcademicYears){<option value="@year.Id" selected="@(year.Id == Model.AcademicYearId)">@year.Name</option>}</select></div>
        <div class="col-md-4"><label class="form-label">@L["GroupType"]</label><select class="form-select" name="GroupType"><option value="@((int)GroupType.Public)" selected="@(Model.GroupType == GroupType.Public)">@L["PublicGroup"]</option><option value="@((int)GroupType.Private)" selected="@(Model.GroupType == GroupType.Private)">@L["PrivateLesson"]</option></select></div>
        <div class="col-md-4"><label class="form-label">@L["DefaultLessonPrice"]</label><input class="form-control" type="number" step="0.01" name="DefaultLessonPrice" value="@Model.DefaultLessonPrice" /></div>
        <div class="col-md-4"><label class="form-check mt-4"><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /> @L["Active"]</label></div>
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">@L["Time"]</label>
                <button class="btn btn-outline-primary btn-sm" type="button" id="AddSchedule">إضافة موعد</button>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="schedulesTable">
                    <thead><tr><th>@L["Day"]</th><th>@L["StartTime"]</th><th>@L["EndTime"]</th><th></th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < schedules.Count; i++)
                    {
                        <tr>
                            <td><select class="form-select schedule-day" name="Schedules[@i].DayOfWeek">@foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>()){<option value="@((int)day)" selected="@(day == schedules[i].DayOfWeek)">@L[day.ToString()]</option>}</select></td>
                            <td><input class="form-control schedule-start" type="time" name="Schedules[@i].StartTime" value="@schedules[i].StartTime.ToString("HH:mm")" /></td>
                            <td><input class="form-control schedule-end" type="time" name="Schedules[@i].EndTime" value="@schedules[i].EndTime.ToString("HH:mm")" /></td>
                            <td><button class="btn btn-outline-danger btn-sm remove-schedule" type="button">@L["Delete"]</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <button class="btn btn-primary mt-3">@L["Save"]</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index">@L["Back"]</a>
</form>

@section Scripts {
    <script>
        initGroupSchedulesForm('#groupForm', '#schedulesTable', '#AddSchedule');
    </script>
}

@model TeacherGroupsManager.Dtos.CreateStudentDto
@{ ViewData["Title"] = L["Add"] + " - " + L["Students"]; }
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@L["StudentName"]</label><input class="form-control" name="FullName" value="@Model.FullName" /></div>
        <div class="col-md-6"><label class="form-label">@L["StudentMobile"]</label><input class="form-control" name="Mobile" value="@Model.Mobile" /></div>
        <div class="col-md-6"><label class="form-label">@L["ParentMobile"]</label><input class="form-control" name="ParentMobile" value="@Model.ParentMobile" /></div>
        <div class="col-md-6"><label class="form-label">@L["AcademicYear"]</label><select class="form-select" name="AcademicYearId"><option value="0">@L["SelectAcademicYear"]</option>@foreach (var year in (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears){<option value="@year.Id">@year.Name</option>}</select></div>
        <div class="col-md-6"><label class="form-label">@L["Group"]</label><select class="form-select" name="GroupId"><option value="0">@L["SelectGroup"]</option>@foreach (var group in (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups){<option value="@group.Id">@group.Name</option>}</select></div>
        <div class="col-12"><label class="form-label">@L["Notes"]</label><textarea class="form-control" name="Notes">@Model.Notes</textarea></div>
    </div>
    <button class="btn btn-primary mt-3">@L["Save"]</button>
</form>





@model IReadOnlyList<TeacherGroupsManager.Dtos.StudentDto>
@{ ViewData["Title"] = "الطلاب"; }
<p><a class="btn btn-primary" asp-action="Create">إضافة طالب</a></p>
<div class="panel"><table class="table align-middle"><thead><tr><th>الاسم</th><th>الجوال</th><th>ولي الأمر</th><th>السنة الدراسية</th><th>المجموعة</th><th>الحالة</th><th></th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.FullName</td><td>@item.Mobile</td><td>@item.ParentMobile</td><td>@item.AcademicYearName</td><td>@item.GroupName</td><td>@(item.IsActive ? "نشط" : "غير نشط")</td>
        <td class="text-nowrap">
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">تعديل</a>
            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('هل تريد حذف هذا السجل؟')">حذف</button></form>
        </td>
    </tr>
}
</tbody></table></div>

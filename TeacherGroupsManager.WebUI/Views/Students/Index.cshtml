@{
    ViewData["Title"] = L["Students"];
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
}
@Html.AntiForgeryToken()
<div class="em-page-header">
    <h1>@ViewData["Title"]</h1>
    <div class="em-add-btn-wrap">
        <a class="btn btn-primary" asp-action="Create">@L["Add"]</a>
    </div>
</div>
<div class="em-toolbar panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">@L["StudentName"]</label><input id="FullName" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["Mobile"]</label><input id="Mobile" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["ParentMobile"]</label><input id="ParentMobile" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["AcademicYear"]</label><select id="AcademicYearId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Group"]</label><select id="GroupId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-1"><label class="form-label">@L["Status"]</label><select id="IsActive" class="form-select"><option value="">@L["All"]</option><option value="true">@L["Active"]</option><option value="false">@L["Inactive"]</option></select></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive app-table-shell">
    <table id="studentsTable" class="table align-middle w-100">
        <thead><tr><th>@L["Name"]</th><th>@L["Mobile"]</th><th>@L["ParentMobile"]</th><th>@L["AcademicYear"]</th><th>@L["Group"]</th><th>@L["Status"]</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#studentsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: {
                fullName: '#FullName',
                mobile: '#Mobile',
                parentMobile: '#ParentMobile',
                academicYearId: '#AcademicYearId',
                groupId: '#GroupId',
                isActive: '#IsActive'
            },
            columns: [
                { data: 'fullName' },
                { data: 'mobile' },
                { data: 'parentMobile' },
                { data: 'academicYearName' },
                { data: 'groupName' },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Students', id); } }
            ]
        });
    </script>
}





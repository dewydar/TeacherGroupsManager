@using System.Globalization
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var bootstrapCss = isRtl
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    string? NavCurrent(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="@culture" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["AppName"]</title>
    <script>
        document.documentElement.dataset.theme = localStorage.getItem('tgm-theme') || 'light';
    </script>
    <link rel="stylesheet" href="@bootstrapCss" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">@L["AppName"]</div>
            <nav class="nav flex-column gap-1">
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.DashboardView)) { <a class="@NavClass("Dashboard")" aria-current="@NavCurrent("Dashboard")" asp-controller="Dashboard" asp-action="Index">@L["Dashboard"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.RolesManage)) { <a class="@NavClass("Roles")" aria-current="@NavCurrent("Roles")" asp-controller="Roles" asp-action="Index">@L["RolesManagement"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.EmployeesManage)) { <a class="@NavClass("Employees")" aria-current="@NavCurrent("Employees")" asp-controller="Employees" asp-action="Index">@L["EmployeesManagement"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.AcademicYearsManage)) { <a class="@NavClass("AcademicYears")" aria-current="@NavCurrent("AcademicYears")" asp-controller="AcademicYears" asp-action="Index">@L["AcademicYears"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.GroupsManage)) { <a class="@NavClass("Groups")" aria-current="@NavCurrent("Groups")" asp-controller="Groups" asp-action="Index">@L["Groups"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.StudentsManage)) { <a class="@NavClass("Students")" aria-current="@NavCurrent("Students")" asp-controller="Students" asp-action="Index">@L["Students"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.LessonsManage)) { <a class="@NavClass("Lessons")" aria-current="@NavCurrent("Lessons")" asp-controller="Lessons" asp-action="Index">@L["Lessons"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.PaymentsManage)) { <a class="@NavClass("Payments")" aria-current="@NavCurrent("Payments")" asp-controller="Payments" asp-action="Index">@L["MonthlyPayments"]</a> }
                @if (User.HasClaim("Permission", TeacherGroupsManager.Core.Constants.PermissionCodes.ReportsView)) { <a class="@NavClass("Reports")" aria-current="@NavCurrent("Reports")" asp-controller="Reports" asp-action="Index">@L["Reports"]</a> }
                <a class="@NavClass("Account")" aria-current="@NavCurrent("Account")" asp-controller="Account" asp-action="ResetPassword">@L["ChangePassword"]</a>
                <a class="nav-link" asp-controller="Account" asp-action="Logout">@L["Logout"]</a>
            </nav>
        </aside>
        <main class="content">
            <header class="topbar">
                <div>
                    <div class="breadcrumb-ar">@L["Home"] / @ViewData["Title"]</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="topbar-actions">
                    <form asp-controller="Culture" asp-action="Set" method="post" class="culture-form">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <label class="visually-hidden" for="cultureSelector">@L["Language"]</label>
                        <select id="cultureSelector" class="form-select form-select-sm" name="culture" onchange="this.form.submit()">
                            <option value="ar-EG" selected="@(culture.StartsWith("ar"))">@L["Arabic"]</option>
                            <option value="en-US" selected="@(culture.StartsWith("en"))">@L["English"]</option>
                            <option value="fr-FR" selected="@(culture.StartsWith("fr"))">@L["French"]</option>
                        </select>
                    </form>
                    <button class="btn btn-sm btn-outline-secondary theme-toggle" type="button" data-theme-toggle>
                        <span data-theme-label-light>@L["DarkTheme"]</span>
                        <span data-theme-label-dark>@L["LightTheme"]</span>
                    </button>
                </div>
            </header>
            @if (TempData["Success"] is not null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/datatables-helper.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




@{ ViewData["Title"] = L["AcademicYears"]; }
@Html.AntiForgeryToken()
<p><a class="btn btn-primary" asp-action="Create">@L["Add"]</a></p>
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">@L["Name"]</label><input id="Name" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">@L["StartDateFrom"]</label><input id="StartDate" class="form-control" type="date" /></div>
        <div class="col-md-3"><label class="form-label">@L["EndDateTo"]</label><input id="EndDate" class="form-control" type="date" /></div>
        <div class="col-md-3"><label class="form-label">@L["Status"]</label><select id="IsActive" class="form-select"><option value="">@L["All"]</option><option value="true">@L["Active"]</option><option value="false">@L["Inactive"]</option></select></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive">
    <table id="academicYearsTable" class="table align-middle w-100">
        <thead><tr><th>@L["Name"]</th><th>@L["StartDate"]</th><th>@L["EndDate"]</th><th>@L["MonthlyPrice"]</th><th>@L["Status"]</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        initServerDataTable({
            tableSelector: '#academicYearsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { name: '#Name', startDate: '#StartDate', endDate: '#EndDate', isActive: '#IsActive' },
            columns: [
                { data: 'name' },
                { data: 'startDate', render: renderDate },
                { data: 'endDate', render: renderDate },
                { data: 'monthlyPrice', render: renderMoney },
                { data: 'isActive', render: renderBooleanStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('AcademicYears', id); } }
            ]
        });
    </script>
}






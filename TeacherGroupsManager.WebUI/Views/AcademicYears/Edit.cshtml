@model TeacherGroupsManager.Dtos.EditAcademicYearDto
@{
    ViewData["Title"] = L["Edit"] + " - " + L["AcademicYears"];
}
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3"><label class="form-label">@L["Name"]</label><input class="form-control" name="Name" value="@Model.Name" /></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@L["StartDate"]</label><input class="form-control" type="date" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-6"><label class="form-label">@L["EndDate"]</label><input class="form-control" type="date" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></div>
        <div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /> @L["Active"]</label></div>
    </div>
    <button class="btn btn-primary mt-3">@L["Save"]</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index">@L["Back"]</a>
</form>





@model TeacherGroupsManager.Dtos.CreateMonthlyPaymentDto
@{ ViewData["Title"] = L["Add"] + " - " + L["MonthlyPayments"]; }
<form method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">@L["Student"]</label><select class="form-select" name="StudentId"><option value="0">@L["SelectStudent"]</option>@foreach (var student in (IReadOnlyList<TeacherGroupsManager.Dtos.StudentDto>)ViewBag.Students){<option value="@student.Id" data-group="@student.GroupId" data-year="@student.AcademicYearId">@student.FullName - @student.GroupName</option>}</select></div>
        <div class="col-md-3"><label class="form-label">@L["Month"]</label><input class="form-control" type="number" name="Month" value="@Model.Month" /></div>
        <div class="col-md-3"><label class="form-label">@L["Year"]</label><input class="form-control" type="number" name="Year" value="@Model.Year" /></div>
        <div class="col-md-4"><label class="form-label">@L["RequiredAmount"]</label><input class="form-control" type="number" step="0.01" name="RequiredAmount" value="@Model.RequiredAmount" /></div>
        <div class="col-md-4"><label class="form-label">@L["PaidAmount"]</label><input class="form-control" type="number" step="0.01" name="PaidAmount" value="@Model.PaidAmount" /></div>
        <div class="col-md-4"><label class="form-label">@L["PaymentDate"]</label><input class="form-control" type="date" name="PaymentDate" /></div>
        <div class="col-12"><label class="form-label">@L["Notes"]</label><textarea class="form-control" name="Notes">@Model.Notes</textarea></div>
    </div>
    <input type="hidden" name="GroupId" id="GroupId" value="0" />
    <input type="hidden" name="AcademicYearId" id="AcademicYearId" value="0" />
    <button class="btn btn-primary mt-3">@L["Save"]</button>
</form>
@section Scripts {
<script>
document.querySelector('[name="StudentId"]').addEventListener('change', function () {
    const option = this.options[this.selectedIndex];
    document.getElementById('GroupId').value = option.dataset.group || '0';
    document.getElementById('AcademicYearId').value = option.dataset.year || '0';
});
</script>
}





@model TeacherGroupsManager.Dtos.CreateMonthlyPaymentDto
@{ ViewData["Title"] = "إضافة مدفوعة شهرية"; }
<form method="post" class="panel">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">الطالب</label><select class="form-select" name="StudentId"><option value="">اختر الطالب</option>@foreach (var student in (IReadOnlyList<TeacherGroupsManager.Dtos.StudentDto>)ViewBag.Students){<option value="@student.Id" data-group="@student.GroupId" data-year="@student.AcademicYearId">@student.FullName - @student.GroupName</option>}</select></div>
        <div class="col-md-3"><label class="form-label">الشهر</label><input class="form-control" type="number" name="Month" value="@Model.Month" /></div>
        <div class="col-md-3"><label class="form-label">السنة</label><input class="form-control" type="number" name="Year" value="@Model.Year" /></div>
        <div class="col-md-4"><label class="form-label">المبلغ المطلوب</label><input class="form-control" type="number" step="0.01" name="RequiredAmount" value="@Model.RequiredAmount" /></div>
        <div class="col-md-4"><label class="form-label">المبلغ المدفوع</label><input class="form-control" type="number" step="0.01" name="PaidAmount" value="@Model.PaidAmount" /></div>
        <div class="col-md-4"><label class="form-label">تاريخ الدفع</label><input class="form-control" type="date" name="PaymentDate" /></div>
        <div class="col-12"><label class="form-label">ملاحظات</label><textarea class="form-control" name="Notes">@Model.Notes</textarea></div>
    </div>
    <input type="hidden" name="GroupId" id="GroupId" />
    <input type="hidden" name="AcademicYearId" id="AcademicYearId" />
    <button class="btn btn-primary mt-3">حفظ</button>
</form>
@section Scripts {
<script>
document.querySelector('[name="StudentId"]').addEventListener('change', function () {
    const option = this.options[this.selectedIndex];
    document.getElementById('GroupId').value = option.dataset.group || '';
    document.getElementById('AcademicYearId').value = option.dataset.year || '';
});
</script>
}

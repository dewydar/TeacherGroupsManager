@{
    ViewData["Title"] = L["MonthlyPayments"];
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
    var initialMonth = ViewBag.Month?.ToString() ?? "";
    var initialYear = ViewBag.Year?.ToString() ?? "";
    var initialStatus = ViewBag.Status is null ? "" : ((int)ViewBag.Status).ToString();
}
@Html.AntiForgeryToken()
<div class="em-page-header">
    <h1>@ViewData["Title"]</h1>
    <div class="em-add-btn-wrap">
        <a class="btn btn-primary" asp-action="Create">@L["Add"]</a>
    </div>
</div>
<div class="em-toolbar panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">@L["Student"]</label><input id="Student" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">@L["AcademicYear"]</label><select id="AcademicYearId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">@L["Group"]</label><select id="GroupId" class="form-select"><option value="">@L["All"]</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-1"><label class="form-label">@L["Month"]</label><input id="Month" class="form-control" type="number" min="1" max="12" /></div>
        <div class="col-md-1"><label class="form-label">@L["Year"]</label><input id="Year" class="form-control" type="number" /></div>
        <div class="col-md-2"><label class="form-label">@L["Status"]</label><select id="PaymentStatus" class="form-select"><option value="">@L["All"]</option><option value="1">@L["Unpaid"]</option><option value="2">@L["PartiallyPaid"]</option><option value="3">@L["Paid"]</option></select></div>
        <div class="col-md-2"><label class="form-label">@L["PaymentDateFrom"]</label><input id="PaymentDateFrom" class="form-control" type="date" /></div>
        <div class="col-md-2"><label class="form-label">@L["PaymentDateTo"]</label><input id="PaymentDateTo" class="form-control" type="date" /></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">@L["Search"]</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">@L["Reset"]</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">@L["Reload"]</button></div>
    </div>
</div>
<div class="panel table-responsive app-table-shell">
    <table id="paymentsTable" class="table align-middle w-100">
        <thead><tr><th>@L["Student"]</th><th>@L["Group"]</th><th>@L["AcademicYear"]</th><th>@L["Month"]</th><th>@L["Year"]</th><th>@L["RequiredAmount"]</th><th>@L["PaidAmount"]</th><th>@L["RemainingAmount"]</th><th>@L["Status"]</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $('#Month').val('@initialMonth');
        $('#Year').val('@initialYear');
        $('#PaymentStatus').val('@initialStatus');
        initServerDataTable({
            tableSelector: '#paymentsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { student: '#Student', academicYearId: '#AcademicYearId', groupId: '#GroupId', month: '#Month', year: '#Year', paymentStatus: '#PaymentStatus', paymentDateFrom: '#PaymentDateFrom', paymentDateTo: '#PaymentDateTo' },
            columns: [
                { data: 'studentName' },
                { data: 'groupName' },
                { data: 'academicYearName' },
                { data: 'month' },
                { data: 'year' },
                { data: 'requiredAmount', render: renderMoney },
                { data: 'paidAmount', render: renderMoney },
                { data: 'remainingAmount', render: renderMoney },
                { data: 'paymentStatus', render: renderPaymentStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Payments', id); } }
            ]
        });
    </script>
}





@{
    ViewData["Title"] = "المدفوعات الشهرية";
    var academicYears = (IReadOnlyList<TeacherGroupsManager.Dtos.AcademicYearDto>)ViewBag.AcademicYears;
    var groups = (IReadOnlyList<TeacherGroupsManager.Dtos.GroupDto>)ViewBag.Groups;
    var initialMonth = ViewBag.Month?.ToString() ?? "";
    var initialYear = ViewBag.Year?.ToString() ?? "";
    var initialStatus = ViewBag.Status is null ? "" : ((int)ViewBag.Status).ToString();
}
@Html.AntiForgeryToken()
<p><a class="btn btn-primary" asp-action="Create">إضافة مدفوعة</a></p>
<div class="panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">الطالب</label><input id="Student" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">السنة الدراسية</label><select id="AcademicYearId" class="form-select"><option value="">الكل</option>@foreach (var item in academicYears){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-2"><label class="form-label">المجموعة</label><select id="GroupId" class="form-select"><option value="">الكل</option>@foreach (var item in groups){<option value="@item.Id">@item.Name</option>}</select></div>
        <div class="col-md-1"><label class="form-label">الشهر</label><input id="Month" class="form-control" type="number" min="1" max="12" /></div>
        <div class="col-md-1"><label class="form-label">السنة</label><input id="Year" class="form-control" type="number" /></div>
        <div class="col-md-2"><label class="form-label">الحالة</label><select id="PaymentStatus" class="form-select"><option value="">الكل</option><option value="1">غير مدفوع</option><option value="2">مدفوع جزئي</option><option value="3">مدفوع</option></select></div>
        <div class="col-md-2"><label class="form-label">تاريخ الدفع من</label><input id="PaymentDateFrom" class="form-control" type="date" /></div>
        <div class="col-md-2"><label class="form-label">تاريخ الدفع إلى</label><input id="PaymentDateTo" class="form-control" type="date" /></div>
        <div class="col-12 d-flex gap-2"><button id="SearchFilters" class="btn btn-outline-primary" type="button">بحث</button><button id="ResetFilters" class="btn btn-outline-secondary" type="button">إعادة تعيين</button><button id="ReloadTable" class="btn btn-outline-dark" type="button">تحديث</button></div>
    </div>
</div>
<div class="panel table-responsive">
    <table id="paymentsTable" class="table align-middle w-100">
        <thead><tr><th>الطالب</th><th>المجموعة</th><th>السنة الدراسية</th><th>الشهر</th><th>السنة</th><th>المطلوب</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        $('#Month').val('@initialMonth');
        $('#Year').val('@initialYear');
        $('#PaymentStatus').val('@initialStatus');
        initServerDataTable({
            tableSelector: '#paymentsTable',
            url: '@Url.Action("GetData")',
            searchButtonSelector: '#SearchFilters',
            resetButtonSelector: '#ResetFilters',
            reloadButtonSelector: '#ReloadTable',
            filters: { student: '#Student', academicYearId: '#AcademicYearId', groupId: '#GroupId', month: '#Month', year: '#Year', paymentStatus: '#PaymentStatus', paymentDateFrom: '#PaymentDateFrom', paymentDateTo: '#PaymentDateTo' },
            columns: [
                { data: 'studentName' },
                { data: 'groupName' },
                { data: 'academicYearName' },
                { data: 'month' },
                { data: 'year' },
                { data: 'requiredAmount', render: renderMoney },
                { data: 'paidAmount', render: renderMoney },
                { data: 'remainingAmount', render: renderMoney },
                { data: 'paymentStatus', render: renderPaymentStatus },
                { data: 'id', orderable: false, searchable: false, render: function (id) { return renderActions('Payments', id); } }
            ]
        });
    </script>
}

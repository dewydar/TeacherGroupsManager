@using System.Globalization
@model TeacherGroupsManager.Dtos.LoginDto
@{
    Layout = null;
    var culture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var bootstrapCss = isRtl
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
}
<!DOCTYPE html>
<html lang="@culture" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Login"] - @L["AppName"]</title>
    <script>document.documentElement.dataset.theme = localStorage.getItem('tgm-theme') || 'light';</script>
    <link rel="stylesheet" href="@bootstrapCss" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="container d-flex align-items-center justify-content-center min-vh-100">
        <form asp-action="Login" method="post" class="panel login-panel">
            <h1 class="h4 mb-3">@L["Login"]</h1>
            @if (ViewBag.Error is not null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <div class="mb-3">
                <label class="form-label">@L["Username"]</label>
                <input class="form-control" name="Username" value="@Model.Username" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["Password"]</label>
                <input class="form-control" name="Password" type="password" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="RememberMe" value="true" />
                <label class="form-check-label">@L["RememberMe"]</label>
            </div>
            <button class="btn btn-primary w-100">@L["Login"]</button>
        </form>
    </main>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>




@model TeacherGroupsManager.Dtos.ResetPasswordDto

<h1 class="h4 mb-3">@ViewData["Title"]</h1>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<input type="hidden" name="IsFirstTime" value="@Model.IsFirstTime.ToString().ToLowerInvariant()" />
@if (Model.IsFirstTime)
{
    <input type="hidden" name="Username" value="@Model.Username" />
}
else
{
    <div class="mb-3">
        <label class="form-label">@L["CurrentPassword"]</label>
        <div class="input-group password-input-group">
            <input class="form-control" type="password" name="CurrentPassword" />
            <button class="btn btn-outline-secondary password-toggle" type="button" data-password-toggle aria-pressed="false" title="@L["ShowPassword"]">
                <svg data-password-icon-show class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                <svg data-password-icon-hide class="password-toggle-icon d-none" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /><path d="M4 4l16 16" /></svg>
            </button>
        </div>
    </div>
}
<div class="mb-3">
    <label class="form-label">@L["NewPassword"]</label>
    <div class="input-group password-input-group">
        <input class="form-control" type="password" name="NewPassword" />
        <button class="btn btn-outline-secondary password-toggle" type="button" data-password-toggle aria-pressed="false" title="@L["ShowPassword"]">
            <svg data-password-icon-show class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg data-password-icon-hide class="password-toggle-icon d-none" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /><path d="M4 4l16 16" /></svg>
        </button>
    </div>
</div>
<div class="mb-3">
    <label class="form-label">@L["ConfirmPassword"]</label>
    <div class="input-group password-input-group">
        <input class="form-control" type="password" name="ConfirmPassword" />
        <button class="btn btn-outline-secondary password-toggle" type="button" data-password-toggle aria-pressed="false" title="@L["ShowPassword"]">
            <svg data-password-icon-show class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg data-password-icon-hide class="password-toggle-icon d-none" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /><path d="M4 4l16 16" /></svg>
        </button>
    </div>
</div>
<button class="btn btn-primary w-100">@L["Save"]</button>

@using System.Globalization
@model TeacherGroupsManager.Dtos.ResetPasswordDto
@{
    ViewData["Title"] = Model.IsFirstTime ? L["PasswordSetup"] : L["ChangePassword"];
    var culture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var bootstrapCss = isRtl
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
    if (Model.IsFirstTime)
    {
        Layout = null;
    }
}

@if (Model.IsFirstTime)
{
    <!DOCTYPE html>
    <html lang="@culture" dir="@direction">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] - @L["AppName"]</title>
        <script>document.documentElement.dataset.theme = localStorage.getItem('tgm-theme') || 'light';</script>
        <link rel="stylesheet" href="@bootstrapCss" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <main class="container d-flex align-items-center justify-content-center min-vh-100">
            <form asp-action="ResetPassword" method="post" class="panel login-panel">
                @await Html.PartialAsync("_ResetPasswordFields", Model)
            </form>
        </main>
        <script src="~/js/theme.js" asp-append-version="true"></script>
        <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    </body>
</html>
}
else
{
    <form asp-action="ResetPassword" method="post" class="panel">
        @await Html.PartialAsync("_ResetPasswordFields", Model)
    </form>
}
